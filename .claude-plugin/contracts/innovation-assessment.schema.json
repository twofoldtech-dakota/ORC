{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Innovation Assessment",
  "type": "object",
  "required": ["story_id", "component", "novel_techniques", "innovation_score"],
  "properties": {
    "story_id": {
      "type": "string",
      "description": "The ID of the story being assessed"
    },
    "component": {
      "type": "string",
      "description": "Name of the component being assessed"
    },
    "novel_techniques": {
      "type": "array",
      "description": "List of novel techniques used in this implementation",
      "items": {
        "type": "object",
        "required": ["technique", "inspiration", "innovation_points"],
        "properties": {
          "technique": {
            "type": "string",
            "description": "Description of the novel technique"
          },
          "inspiration": {
            "type": "string",
            "description": "Source of inspiration for this technique"
          },
          "innovation_points": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "Points awarded for this technique (1-3)"
          }
        }
      }
    },
    "conventional_choices": {
      "type": "array",
      "description": "List of conventional patterns used with justification",
      "items": {
        "type": "object",
        "required": ["element", "justification", "acceptable"],
        "properties": {
          "element": {
            "type": "string",
            "description": "The conventional element used"
          },
          "justification": {
            "type": "string",
            "description": "Why this conventional choice is appropriate"
          },
          "acceptable": {
            "type": "boolean",
            "description": "Whether this conventional choice is acceptable"
          }
        }
      }
    },
    "innovation_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Overall innovation score (1-10)"
    },
    "minimum_required": {
      "type": "integer",
      "description": "Minimum score required for this component type"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail"],
      "description": "Whether the component meets the innovation threshold"
    }
  }
}
