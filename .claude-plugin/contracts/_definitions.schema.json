{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "_definitions.schema.json",
  "title": "ORC Common Definitions",
  "description": "Shared definitions used across ORC schemas",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "UUID v4 format"
    },
    "epicId": {
      "type": "string",
      "pattern": "^E[0-9]+$",
      "description": "Epic identifier (e.g., E1, E2)"
    },
    "featureId": {
      "type": "string",
      "pattern": "^E[0-9]+-F[0-9]+$",
      "description": "Feature identifier (e.g., E1-F1)"
    },
    "storyId": {
      "type": "string",
      "pattern": "^E[0-9]+-F[0-9]+-S[0-9]+$",
      "description": "Story identifier (e.g., E1-F1-S1)"
    },
    "patternId": {
      "type": "string",
      "pattern": "^(sp|ap)_[a-z0-9_]+$",
      "description": "Pattern identifier (sp_ for success, ap_ for anti)"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "approved", "in_progress", "completed", "blocked"],
      "description": "Common status values"
    },
    "complexity": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Estimated complexity level"
    },
    "impact": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Impact level for deviations"
    },
    "deviationCategory": {
      "type": "string",
      "enum": ["library_choice", "pattern_change", "security", "architecture", "implementation"],
      "description": "Category of deviation from suggested approach"
    },
    "phase": {
      "type": "string",
      "enum": ["idle", "analyze", "plan", "execute", "review", "learn", "complete"],
      "description": "Current execution phase"
    },
    "filePath": {
      "type": "string",
      "minLength": 1,
      "description": "Relative file path within project"
    },
    "acceptanceCriterion": {
      "type": "string",
      "minLength": 1,
      "description": "Single acceptance criterion statement"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score between 0 and 1"
    },
    "specialistType": {
      "type": "string",
      "enum": [
        "architect",
        "product-designer",
        "devops",
        "security",
        "database",
        "frontend",
        "backend",
        "fullstack",
        "qa",
        "biz-analyst",
        "content-strategist"
      ],
      "description": "Available specialist agent types"
    },
    "coreAgentType": {
      "type": "string",
      "enum": ["orchestrator", "analyzer", "planner", "implementer", "validator", "reviewer", "learner"],
      "description": "Core agent types"
    }
  }
}
